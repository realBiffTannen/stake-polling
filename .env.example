# Copy to .env (gitignored) and fill in what you use. Every line is optional.
# A variable already set in the real environment wins over this file.

# --- Redis ---------------------------------------------------------------
# No credentials by default: a local Redis on a trusted machine.
# REDIS_URL=redis://127.0.0.1:6379
# For an authenticated server (ACL user, or requirepass with no username):
# REDIS_USERNAME=stake-polling
# REDIS_PASSWORD=
# Every screen shows a sticky alert while Redis's used_memory is over this.
# Binary units, as redis-cli prints them: 2GB is its "2.00G".
# REDIS_DB_SIZE=2GB

# --- Nightly archive -----------------------------------------------------
# Unset: each UTC day is archived to ./stake-polling-logrotate-data.
# Set: archived to s3://$S3_BUCKET/$S3_PREFIX/<team>/ instead.
# scripts/create-s3-bucket.py creates the bucket and fills these in.
# S3_BUCKET=
# S3_PREFIX=stake-polling
# AWS_REGION=us-east-1
# How long the archive page's presigned download links last (max 604800 = 7 days).
# S3_PRESIGN_SECONDS=3600
# Credentials: any the AWS SDK understands. Either a named profile...
# AWS_PROFILE=stake-polling-archiver
# ...or the access key of the least-privilege user the script creates.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
