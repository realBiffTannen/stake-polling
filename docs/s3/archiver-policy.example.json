{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteArchives",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::YOUR-BUCKET/stake-polling/*"
    },
    {
      "Sid": "ListArchives",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR-BUCKET",
      "Condition": { "StringLike": { "s3:prefix": ["stake-polling/*"] } }
    }
  ]
}
